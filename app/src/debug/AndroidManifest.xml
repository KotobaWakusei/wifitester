<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only manifest entries.

  The adb debug bridge is declared exclusively in the debug source set, so
  release builds never contain the exported receiver at all. It is intended
  for development on a personal device: the app is debuggable, so the bridge
  log is reachable through `adb shell run-as`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Reachable only through explicit components, which is how
            `adb shell am start -n ...` delivers. An activity start wakes the
            process immediately, unlike manifest broadcasts which recent
            Android releases defer for backgrounded apps. The activity
            additionally ignores every command in release builds.
        -->
        <activity
            android:name="me.paranoid.wifikill.BridgeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name="me.paranoid.wifikill.DebugBridgeReceiver"
            android:exported="true" />

    </application>
</manifest>
