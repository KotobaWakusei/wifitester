<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tool package downloads run as a foreground service with progress. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".WiFiTesterApp"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:theme="@style/Theme.WiFiTester"
        android:supportsRtl="true">

        <!-- Shell with the three primary workspaces and the bottom navigation. -->
        <activity
            android:name="me.paranoid.wifikill.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WiFiTester">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Secondary screen opened from the network list. -->
        <activity
            android:name="me.paranoid.wifikill.NetworkDetailActivity"
            android:exported="false"
            android:label="@string/detail_title"
            android:theme="@style/Theme.WiFiTester"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <!-- Passive monitoring and capture. -->
        <activity
            android:name="me.paranoid.wifikill.MonitorModeActivity"
            android:exported="false"
            android:label="@string/monitor_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <!-- Active test workbench. Rotation is handled in place: recreating the
             activity would destroy the running RootProcess (and the log shown
             on screen) in the middle of a test. -->
        <activity
            android:name="me.paranoid.wifikill.AttackActivity"
            android:exported="false"
            android:label="@string/attack_title"
            android:theme="@style/MonitorTheme"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <activity
            android:name="me.paranoid.wifikill.AircrackToolkitActivity"
            android:exported="false"
            android:label="@string/toolkit_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <activity
            android:name="me.paranoid.wifikill.FrameAnalysisActivity"
            android:exported="false"
            android:label="@string/frames_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <activity
            android:name="me.paranoid.wifikill.WiFiAuditActivity"
            android:exported="false"
            android:label="@string/audit_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <activity
            android:name="me.paranoid.wifikill.WordlistActivity"
            android:exported="false"
            android:label="@string/wordlist_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <activity
            android:name="me.paranoid.wifikill.DiagnosisActivity"
            android:exported="false"
            android:label="@string/diag_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <activity
            android:name="me.paranoid.wifikill.ChannelAnalysisActivity"
            android:exported="false"
            android:label="@string/channel_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <activity
            android:name="me.paranoid.wifikill.CaptureManagerActivity"
            android:exported="false"
            android:label="@string/capture_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <activity
            android:name="me.paranoid.wifikill.AircrackNgActivity"
            android:exported="false"
            android:label="@string/inventory_title"
            android:theme="@style/MonitorTheme"
            android:parentActivityName="me.paranoid.wifikill.MainActivity" />

        <!--
            Persists the per-app locale on Android 12 and below. On Android 13
            and above the system locale manager takes over.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Shares capture files and wordlists with other apps (read-only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- First-launch disclaimer and tool package selection. -->
        <activity
            android:name="me.paranoid.wifikill.ToolSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.WiFiTester"
            android:screenOrientation="portrait" />

        <!-- Background downloader for optional tool packages. -->
        <service
            android:name="me.paranoid.wifikill.ToolInstallerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Keeps a passive capture running after the monitor screen is left.
            It is a background operation rather than a media task: the Android
            14+ foreground service types have no better match for a capture,
            and the notification is the only UI the service owns.
        -->
        <service
            android:name="me.paranoid.wifikill.MonitorCaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Passive Wi-Fi monitor-mode capture requested by the user" />
        </service>
    </application>
</manifest>
