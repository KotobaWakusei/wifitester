<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Application specific theme attributes. The Material 3 roles
        (colorPrimary, colorSurface, ...) are provided by the Material library
        and must not be redeclared here.
    -->

    <!-- Semantic status colours, not part of the M3 baseline palette. -->
    <attr name="colorSuccess" format="color" />
    <attr name="colorOnSuccess" format="color" />
    <attr name="colorSuccessContainer" format="color" />
    <attr name="colorOnSuccessContainer" format="color" />
    <attr name="colorWarning" format="color" />
    <attr name="colorOnWarning" format="color" />
    <attr name="colorWarningContainer" format="color" />
    <attr name="colorOnWarningContainer" format="color" />

    <!-- Terminal / log surfaces. -->
    <attr name="colorLogBackground" format="color" />
    <attr name="colorLogText" format="color" />
    <attr name="colorLogAccent" format="color" />
    <attr name="colorCodeBackground" format="color" />
    <attr name="colorCodeText" format="color" />
    <attr name="colorCodeAccent" format="color" />
</resources>
