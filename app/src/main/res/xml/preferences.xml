<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="通用设置">
        <CheckBoxPreference
            android:title="全屏显示"
            android:key="pref_key_fullscreen"
            android:summary="隐藏系统通知栏"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="设备列表">
        <CheckBoxPreference
            android:title="显示网络名称"
            android:key="pref_key_show_nbname"
            android:summary="显示 NetBIOS（网络）名称"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="显示 MAC 地址"
            android:key="pref_key_show_hwaddr"
            android:summary="显示网卡的 MAC 地址"
            android:defaultValue="true"/>
        <CheckBoxPreference
            android:title="显示网卡厂商"
            android:key="pref_key_show_vendor"
            android:summary="显示网卡制造商信息"
            android:defaultValue="true"/>
    </PreferenceCategory>
</PreferenceScreen>
